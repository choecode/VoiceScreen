<Window x:Class="VoiceScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceScreen · Discord 双向翻译" Width="920" Height="820" MinWidth="840" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#E6EDF3">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="VoiceScreen" FontSize="34" FontWeight="Bold" />
                <TextBlock Text="Discord 英语/泰语 → 中文字幕 · 按住右 Alt：中文 → 英语语音" Foreground="#8B949E" FontSize="15" Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="处理引擎（三个节点可独立切换）" FontSize="18" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="语音识别 ASR" VerticalAlignment="Center" />
                        <ComboBox x:Name="AsrProviderCombo" Grid.Column="1" Margin="0,4" SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="本地 Whisper（推荐）" Tag="local" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="文本翻译" VerticalAlignment="Center" />
                        <ComboBox x:Name="TranslationProviderCombo" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="本地 OPUS-MT（离线）" Tag="local" />
                            <ComboBoxItem Content="API · MyMemory（联网）" Tag="api" />
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="英文 TTS" VerticalAlignment="Center" />
                        <ComboBox x:Name="TtsProviderCombo" Grid.Row="2" Grid.Column="1" Margin="0,4" SelectionChanged="ProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="本地 Windows Speech（离线）" Tag="local" />
                            <ComboBoxItem Content="API · Edge TTS（联网）" Tag="api" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="三个节点独立配置；ASR 当前仅有本地 Whisper，翻译和 TTS 可任意组合并在运行中切换。"
                               Foreground="#8B949E" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <CheckBox x:Name="LowLatencyIncomingCheckBox" Content="游戏低延迟字幕（边说边显示；停顿约 0.6 秒后定稿）"
                              IsChecked="True" Foreground="#52D3A5" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="音频设备" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1" Text="实体麦克风" VerticalAlignment="Center" />
                    <ComboBox x:Name="MicrophoneCombo" Grid.Row="1" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name" />
                    <TextBlock Grid.Row="2" Text="英文试听耳机" VerticalAlignment="Center" />
                    <ComboBox x:Name="MonitorOutputCombo" Grid.Row="2" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name" />
                    <CheckBox x:Name="MonitorTranslatedSpeechCheckBox" Grid.Row="3" Grid.Column="1" Content="复读已发送英文（在耳机播放；已隔离，不会进入识别循环）" IsChecked="True" Foreground="#E6EDF3" Margin="0,5" />
                    <TextBlock Grid.Row="4" Text="Discord 声音捕获" VerticalAlignment="Center" />
                    <ComboBox x:Name="DiscordOutputCombo" Grid.Row="4" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name" IsEnabled="False" />
                    <TextBlock Grid.Row="5" Text="发送给 Discord" VerticalAlignment="Center" />
                    <ComboBox x:Name="CableRenderCombo" Grid.Row="5" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name" IsEnabled="False" />
                    <CheckBox x:Name="UseProcessLoopbackCheckBox" Grid.Row="6" Grid.Column="1" Content="只抓 Discord 进程音频（已固定启用，不捕获游戏/浏览器声音）" IsChecked="True" IsEnabled="False" Foreground="#E6EDF3" Margin="0,8,0,0" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="本地模型（无外部 API）" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1" Text="双向语音识别" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" Text="faster-whisper base 实时预览 + small 最终定稿 · CPU INT8" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Text="双向文本翻译" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Text="OPUS-MT 中英双向 + 泰英桥接 · CPU INT8" IsReadOnly="True" />
                    <TextBlock Grid.Row="3" Text="英文语音输出" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" Text="Windows Speech · 完全离线" IsReadOnly="True" />
                    <TextBlock Grid.Row="4" Text="英文音色" VerticalAlignment="Center" />
                    <ComboBox x:Name="EnglishVoiceCombo" Grid.Row="4" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#161B22" BorderBrush="#1F6FEB" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="在线组件配置（可选）" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1" Text="Edge 英文音色" VerticalAlignment="Center" />
                    <ComboBox x:Name="ApiEnglishVoiceCombo" Grid.Row="1" Grid.Column="1" Margin="0,5" IsEditable="False" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <Button x:Name="TestCloudApiButton" Content="测试纯 API 与延迟" Width="180" Height="34" Click="TestCloudApiButton_Click" />
                        <TextBlock Text="ASR 始终留在本机；MyMemory 仅接收文字，Edge TTS 仅接收英文。" Foreground="#E3B341" Margin="12,7,0,0" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="5" Margin="0,18,0,0">
                <Border Background="#2D2205" BorderBrush="#9E6A03" BorderThickness="1" CornerRadius="8" Padding="12">
                    <TextBlock Text="接收方向仅捕获 Discord 桌面客户端及其子进程。游戏、浏览器和音乐声音不会送去识别；启动 VoiceScreen 前请先打开 Discord。"
                               Foreground="#E3B341" TextWrapping="Wrap" />
                </Border>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="StartButton" Content="启动" Width="120" Height="40" Margin="0,0,10,0" Click="StartButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#238636" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#2EA043" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2EA043" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#21262D" />
                                        <Setter Property="Foreground" Value="#8B949E" />
                                        <Setter Property="BorderBrush" Value="#30363D" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="StopButton" Content="停止" Width="100" Height="40" Margin="0,0,10,0" Click="StopButton_Click" IsEnabled="False" />
                    <Button Content="刷新设备" Width="110" Height="40" Margin="0,0,10,0" Click="RefreshDevicesButton_Click" />
                    <Button x:Name="AdjustOverlayButton" Content="① 解锁移动/缩放" Width="160" Height="40"
                            Click="AdjustOverlayButton_Click" IsEnabled="False" />
                    <Button x:Name="RestartElevatedButton" Content="以管理员重启（战地）" Width="170" Height="40" Margin="10,0,0,0"
                            Click="RestartElevatedButton_Click" ToolTip="当战地以前台运行时收不到右 Alt，请用同等管理员权限重启 VoiceScreen" />
                </WrapPanel>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="字幕字号" VerticalAlignment="Center" />
                    <Slider x:Name="SubtitleFontSizeSlider" Grid.Column="1" Minimum="14" Maximum="42" Value="24"
                            TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SubtitleFontSizeSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" Text="{Binding ElementName=SubtitleFontSizeSlider, Path=Value, StringFormat={}{0:F0}}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#52D3A5" />
                </Grid>
                <DockPanel Margin="0,14,0,0" LastChildFill="True">
                    <Button x:Name="TestTranslationButton" DockPanel.Dock="Right" Content="翻译并试听（仅耳机）" Width="190" Height="38"
                            Margin="10,0,0,0" Click="TestTranslationButton_Click" IsEnabled="False" />
                    <TextBox x:Name="TestChineseTextBox" Text="敌人在二楼，我们从左边走。" Height="38" Padding="10,7"
                             ToolTip="输入中文，使用本地 OPUS-MT 翻译并只在所选耳机试听，不发送到 Discord" />
                </DockPanel>
                <TextBlock x:Name="StatusText" Text="等待启动" FontSize="15" Margin="0,16,0,0" Foreground="#8B949E" TextWrapping="Wrap" />
                <TextBlock Text="Discord 设置：输入设备选 CABLE Output，输出设备选 HyperX 耳机。不要开启“侦听此设备”。平时原声直通；按住右 Alt 说中文，松开后发送英文。"
                           FontSize="14" Margin="0,10,0,0" Foreground="#52D3A5" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
