<Window x:Class="VoiceScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceScreen – 实时字幕翻译"
        Width="960"
        Height="560"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#060b16"
        Foreground="#EAF0FF"
        WindowState="Normal"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#060b16" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111a30" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#0d1528" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#253868" />
        <SolidColorBrush x:Key="TextBrush" Color="#eaf0ff" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9fb0cc" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4fd1f4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#9ef3c4" />
        <SolidColorBrush x:Key="WarnBrush" Color="#ffd166" />
        <SolidColorBrush x:Key="ComboBgBrush" Color="#0d1528" />
        <SolidColorBrush x:Key="ComboHoverBrush" Color="#1a2647" />
        <SolidColorBrush x:Key="ComboSelBrush" Color="#21315a" />

        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cdd7ee" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0 0 0 8" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#c6d2e7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#334169" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 完整自定义 ComboBox:深色显示框 + 深色弹出下拉 -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ComboBgBrush}" />
            <Setter Property="BorderBrush" Value="#334169" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,0,28,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      RecognizesAccessKey="True" />
                                    <ToggleButton x:Name="DropDownToggle"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Right"
                                                  Width="26"
                                                  Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Data="M0,0 L6,6 L12,0"
                                                          Stroke="#9fb0cc"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource ComboBgBrush}"
                                        BorderBrush="#334169"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4a6cb0" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboSelBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7f93b4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#061224" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#3f7cff" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6ce4ff" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33c2e0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#203a50" />
                                <Setter Property="Foreground" Value="#7f93b4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#dce7f9" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#324167" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4a6cb0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboSelBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#0b1324" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#273554" />
                                <Setter Property="Foreground" Value="#7283a0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#ffd7df" />
            <Setter Property="Background" Value="#20152a" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#5b2f4a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#334169" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VoiceScreen" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock Text="选择一个应用，开始实时字幕翻译"
                               Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="10,5"
                        CornerRadius="999">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="StatusBadgeDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusBadgeText" Text="就绪" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,12,0,0">
                <Border Style="{StaticResource SurfaceCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="监听应用" Style="{StaticResource TitleText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="IncomingProcessCombo" Margin="0,0,10,0"
                                      ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="RefreshDevicesButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Content="刷新列表" Width="104" Margin="0" Click="RefreshDevicesButton_Click" />
                        </Grid>
                        <CheckBox x:Name="EnableOutgoingTranslationCheckBox"
                                  IsChecked="True" Click="EnableOutgoingTranslationCheckBox_Click"
                                  Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0">
                            <TextBlock Text="同时把麦克风中文翻译成英文并发送到语音应用" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="关闭后仍会监听所选应用并显示字幕。" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <Expander Header="高级设置" IsExpanded="False" Margin="2,14,2,0">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="识别与模型" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="语音识别" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="AsrProviderCombo" Margin="0,5,0,10" SelectionChanged="ProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="本地 Whisper" Tag="whisper" />
                                        <ComboBoxItem Content="本地 Sherpa-ONNX Zipformer" Tag="sherpa" />
                                        <ComboBoxItem Content="Spark Qwen3-ASR 1.7B（推荐）" Tag="qwen3-asr" />
                                    </ComboBox>
                                    <TextBlock Text="推理设备" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="AsrDeviceCombo" Margin="0,5,0,10" SelectionChanged="ProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="自动选择" Tag="auto" />
                                        <ComboBoxItem Content="强制 GPU" Tag="cuda" />
                                        <ComboBoxItem Content="强制 CPU" Tag="cpu" />
                                    </ComboBox>
                                    <TextBlock Text="翻译" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="TranslationProviderCombo" Margin="0,5,0,10" SelectionChanged="ProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="Spark Qwen3-4B（推荐）" Tag="local" />
                                        <ComboBoxItem Content="云端 MyMemory" Tag="api" />
                                    </ComboBox>
                                    <TextBlock Text="语音合成" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="TtsProviderCombo" Margin="0,5,0,10" SelectionChanged="ProviderCombo_SelectionChanged">
                                        <ComboBoxItem Content="Windows 本地语音" Tag="local" />
                                        <ComboBoxItem Content="云端 Edge TTS" Tag="api" />
                                    </ComboBox>
                                    <CheckBox x:Name="LowLatencyIncomingCheckBox" IsChecked="True"
                                              Foreground="{StaticResource AccentBrush}" Margin="0,2,0,10"
                                              Content="低延迟实时字幕" />
                                    <TextBlock Text="Spark 服务地址" Style="{StaticResource SectionLabel}" />
                                    <TextBox x:Name="ModelServiceUrlTextBox" Text="http://127.0.0.1:18765/"
                                             Margin="0,5,0,10" ToolTip="Spark 上的 VoiceScreen 模型服务地址；请按部署环境填写" />
                                    <TextBlock Text="访问令牌" Style="{StaticResource SectionLabel}" />
                                    <PasswordBox x:Name="ModelServiceTokenBox" Margin="0,5,0,0"
                                                 ToolTip="已加密保存在本机" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="发送与声音" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="麦克风" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="MicrophoneCombo" Margin="0,5,0,10"
                                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="本地监听输出" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="MonitorOutputCombo" Margin="0,5,0,8"
                                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox x:Name="MonitorTranslatedSpeechCheckBox" IsChecked="True" Margin="0,0,0,10"
                                              Foreground="{StaticResource MutedBrush}" Content="本地同时播放翻译语音" />
                                    <TextBlock Text="虚拟音频线" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="CableRenderCombo" Margin="0,5,0,10" IsEnabled="False"
                                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="本地英文音色" Style="{StaticResource SectionLabel}" />
                                    <ComboBox x:Name="EnglishVoiceCombo" Margin="0,5,0,10"
                                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox x:Name="OutgoingClauseStreamingCheckBox"
                                              Click="OutgoingClauseStreamingCheckBox_Click" Foreground="{StaticResource AccentBrush}"
                                              Margin="0,2,0,0" Content="中文讲话时按自然短句提前发送" />
                                    <CheckBox x:Name="UseProcessLoopbackCheckBox" IsChecked="True" IsEnabled="False"
                                              Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,20,0,18" Background="{StaticResource PanelBorderBrush}" />
                            <TextBlock Text="在线备选与测试" Style="{StaticResource TitleText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Edge 英文音色" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="ApiEnglishVoiceCombo" Grid.Column="1" Margin="0,0,10,0" IsEditable="False" />
                                <Button x:Name="TestCloudApiButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="测试在线服务" Width="130" Margin="0" Click="TestCloudApiButton_Click" />
                            </Grid>
                            <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                <Button x:Name="TestTranslationButton" Style="{StaticResource GhostButton}"
                                        DockPanel.Dock="Right" Content="测试翻译" Width="110" Margin="10,0,0,0"
                                        Click="TestTranslationButton_Click" IsEnabled="False" />
                                <TextBox x:Name="TestChineseTextBox" Text="输入中文句子测试翻译"
                                         ToolTip="输入中文并快速验证翻译结果" TextWrapping="NoWrap" />
                            </DockPanel>
                            <Button x:Name="RestartElevatedButton" Style="{StaticResource DangerButton}"
                                    Content="以管理员身份重启" Width="160" HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Click="RestartElevatedButton_Click" ToolTip="启动被系统权限拦截时使用" />
                            <TextBlock Text="在线服务是可选备用；Spark 模型仅在局域网内访问。"
                                       Style="{StaticResource HintText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始监听"
                            Width="124" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="停止"
                            Width="88" Click="StopButton_Click" IsEnabled="False" />
                    <Button x:Name="AdjustOverlayButton" Style="{StaticResource GhostButton}" Content="调整字幕窗"
                            Width="116" Click="AdjustOverlayButton_Click" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Row="1" Text="就绪" FontSize="13" Margin="0,10,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
