<Window x:Class="VoiceScreen.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="VoiceScreen Subtitle Overlay"
        Width="680" Height="300"
        MinWidth="360" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeChanged="OverlayWindow_SizeChanged"
        PreviewMouseWheel="OverlayWindow_PreviewMouseWheel">
    <Window.Resources>
        <SolidColorBrush x:Key="OverlayBg" Color="#111b2f"/>
        <SolidColorBrush x:Key="OverlayBgDark" Color="#0a1224"/>
        <SolidColorBrush x:Key="OverlayBorder" Color="#30436d"/>
        <SolidColorBrush x:Key="OverlayMuted" Color="#9fb0cc"/>
        <SolidColorBrush x:Key="OverlayPrimary" Color="#4fd1f4"/>
        <SolidColorBrush x:Key="OverlayAccent" Color="#9ef3c4"/>
        <SolidColorBrush x:Key="OverlayWarn" Color="#ffd166"/>
        <DropShadowEffect x:Key="OverlayTextShadow" Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.95"/>
        <Style x:Key="OverlayItemText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="LineHeight" Value="1.25"/>
            <Setter Property="Effect" Value="{StaticResource OverlayTextShadow}"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            BorderBrush="{StaticResource OverlayBorder}"
            BorderThickness="1"
            Padding="14"
            Opacity="0.98">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1f2945" Offset="0"/>
                <GradientStop Color="#0f1728" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Ellipse DockPanel.Dock="Left" x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource OverlayWarn}" Margin="0,0,8,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="HistoryIndicator"
                               Text="Ready: 0 lines"
                               Foreground="{StaticResource OverlayMuted}"
                               FontSize="12"
                               Margin="12,0,0,0" />
                    <TextBlock x:Name="EditHint"
                               Text="拖动位置 · 滚轮浏览历史"
                               Foreground="{StaticResource OverlayAccent}"
                               FontSize="12"
                               Margin="12,0,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Not running"
                           Foreground="#dfe7ff"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </DockPanel>

            <ListBox x:Name="SubtitleList"
                     Grid.Row="1"
                     ItemsSource="{Binding Lines}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=FontSize}"
                                   Style="{StaticResource OverlayItemText}">
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="PreviewBorder"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="8,9,8,6"
                    MaxHeight="102"
                    Background="#1a283f"
                    CornerRadius="8"
                    BorderBrush="{StaticResource OverlayPrimary}"
                    BorderThickness="1,1,1,1"
                    Visibility="Collapsed">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#88FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
                <ScrollViewer x:Name="PreviewScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <TextBlock x:Name="PreviewText"
                               Foreground="{StaticResource OverlayMuted}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="None"
                               Opacity="0.95"
                               Effect="{StaticResource OverlayTextShadow}">
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <Grid x:Name="ResizeHandle"
                  Grid.RowSpan="3"
                  Width="28"
                  Height="28"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed">
                <primitives:Thumb Cursor="SizeNWSE"
                                   DragDelta="ResizeThumb_DragDelta"
                                   Background="Transparent"/>
                <TextBlock Text="↘"
                           Foreground="{StaticResource OverlayPrimary}"
                           FontSize="18"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           IsHitTestVisible="False"
                           Margin="0,0,2,2"/>
            </Grid>
        </Grid>
    </Border>
</Window>
