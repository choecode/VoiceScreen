<Window x:Class="VoiceScreen.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="VoiceScreen 字幕"
        Width="680" Height="300"
        MinWidth="360" MinHeight="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="#A0141820" CornerRadius="12" Padding="16" BorderBrush="#404C5A6B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#E3B341" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="尚未启动" Foreground="#C9D1D9" FontSize="13" />
                <TextBlock x:Name="EditHint" Text="调整模式：拖动顶部移动，拖右下角缩放" Foreground="#FFD166"
                           FontSize="12" HorizontalAlignment="Right" Visibility="Collapsed" />
            </DockPanel>
            <ListBox x:Name="SubtitleList" Grid.Row="1" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                     IsHitTestVisible="False" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="24" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,4">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.95" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid x:Name="ResizeHandle" Grid.RowSpan="2" Width="26" Height="26"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                <primitives:Thumb Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Background="Transparent" />
                <TextBlock Text="◢" Foreground="#FFD166" FontSize="20" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
