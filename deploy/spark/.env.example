# Copy to .env and replace every placeholder before starting Compose.
# Keep .env private; it is ignored by Git.
VOICESCREEN_API_TOKEN=replace-with-a-random-32-byte-token
VOICESCREEN_MODEL_ROOT=/opt/voicescreen/models
VOICESCREEN_VOICE_PROFILE_ROOT=/opt/voicescreen/voice-profiles
VOICESCREEN_VOICE_ID=my-voice
VOICESCREEN_VOICE_REFERENCE=/profiles/my-voice-reference.wav
VOICESCREEN_VOICE_PROMPT=/profiles/my-voice.pt
VOICESCREEN_VOICE_REFERENCE_TEXT=replace-with-the-exact-transcript-of-your-reference-recording
# Only needed for the optional CosyVoice experiment.
COSYVOICE_SOURCE_PATH=/opt/voicescreen-experiments/CosyVoice
