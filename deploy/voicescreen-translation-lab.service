[Unit]
Description=VoiceScreen local translation evaluation lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=choe
Group=choe
WorkingDirectory=/home/choe/VoiceScreen
Environment=VOICESCREEN_MODEL_ROOT=/home/choe/VoiceScreen/models
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_XET=1
ExecStart=/home/choe/VoiceScreen/.venv-translation-lab/bin/python /home/choe/VoiceScreen/src/VoiceScreen.App/LocalService/local_outgoing_service.py --translation-only --host 0.0.0.0 --port 18765
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=3G
TasksMax=256

[Install]
WantedBy=multi-user.target
